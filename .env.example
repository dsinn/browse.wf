# Cloud Sync Configuration (Optional)
# Copy this file to .env and fill in your credentials to enable cloud sync
# The app works perfectly fine without these - it will use localStorage only

# Your database project URL (from Project Settings → API)
VITE_DATABASE_URL=https://your-project-ref.supabase.co

# Your database anon/public key (from Project Settings → API)
VITE_DATABASE_ANON_KEY=your-anon-key-here

# Front Proxy (Cloudflare Worker) secrets — set via Cloudflare dashboard or wrangler, not here:
#   WARFRAME_API_FRONT_PROXY_TOKEN = the shared token clients must send in X-Warframe-API-Front-Proxy-Token
#   DATABASE_URL              = same value as VITE_DATABASE_URL above (enables per-user rate limiting)
#   DATABASE_SERVICE_ROLE_KEY = from database dashboard → Project Settings → API → service_role
