{
  "name": "browse.wf",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npx tsc --watch\" \"node esbuild.config.js --watch\" \"node scripts/render-pages.js --watch\" \"vite --config vitest.config.ts\"",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:api-validation": "API_VALIDATION=1 vitest run test/api-validation.test.ts",
    "render-fixtures": "node test/helpers/render-php.js",
    "render-fixtures:watch": "node test/helpers/render-php.js --watch",
    "typecheck": "tsc && tsc -p tsconfig.lint.json",
    "compile": "npm run typecheck && node esbuild.config.js",
    "build": "node build-gh-pages.js",
    "post-weekly-forecast": "node --env-file-if-exists=.env scripts/post-weekly-forecast.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.0",
    "@types/bootstrap": "^5.2.10",
    "@types/jsdom": "^28.0.1",
    "@types/showdown": "^2.0.6",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "jsdom": "^29.0.0",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.18",
    "warframe-public-export-plus": "^0.5.86",
    "xo": "^2.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1"
  }
}
