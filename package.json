{
  "name": "browse.wf",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npx tsc --watch\" \"node scripts/render-pages.js --watch\" \"vite --config vitest.config.ts\"",
    "lint": "eslint *.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:api-validation": "API_VALIDATION=1 vitest run test/api-validation.test.ts",
    "render-fixtures": "node test/helpers/render-php.js",
    "render-fixtures:watch": "node test/helpers/render-php.js --watch",
    "build": "node build-gh-pages.js",
    "post-weekly-forecast": "node --env-file=.env scripts/post-weekly-forecast.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.0",
    "@types/bootstrap": "^5.2.10",
    "@types/showdown": "^2.0.6",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitest/ui": "^4.0.18",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.2",
    "vite": "^6.4.1",
    "vitest": "^4.0.18",
    "warframe-public-export-plus": "^0.5.86"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1"
  }
}
