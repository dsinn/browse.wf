{
  "name": "browse.wf",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:api-validation": "API_VALIDATION=1 vitest run test/api-validation.test.ts",
    "typecheck": "tsc && tsc -p tsconfig.lint.json",
    "compile": "npm run typecheck && node esbuild.config.js",
    "build": "node build-gh-pages.js",
    "weekly-forecast:post": "tsc && node --env-file-if-exists=.env typestripped/scripts/post-weekly-forecast.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "crc-32": "^1.2.2",
    "warframe-public-export-plus": "^0.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@types/bootstrap": "^5.2.10",
    "@types/jsdom": "^30.0.0",
    "@types/showdown": "^2.0.6",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "chokidar": "^6.0.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.3",
    "jsdom": "^31.0.1",
    "timezone-mock": "^1.4.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^5.1.0",
    "xo": "^5.0.1"
  }
}
