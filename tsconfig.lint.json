{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "lib": ["es2023", "dom"],
    "baseUrl": ".",
    "paths": {
      "@test/*": ["./test/*"]
    }
  },
  "include": ["*.d.ts", "*.config.ts", "src/**/*", "test/**/*", "e2e/**/*", "helpers/**/*", "scripts/**/*"],
  "exclude": ["dist/**/*"]
}
